+};
+
+class ActiveWindowQuery : public QtWayland::org_kde_plasma_window_management
+{
+public:
+    ~ActiveWindowQuery() override
+    {
+        if (isInitialized()) {
+            wl_proxy_destroy(reinterpret_cast<wl_proxy *>(object()));
+        }
+    }
+
+    std::deque<WindowGeometry> windows;
+
+private:
+    void org_kde_plasma_window_management_window_with_uuid(uint32_t, const QString &uuid) override
+    {
+        if (auto window = get_window_by_uuid(uuid)) {
+            windows.emplace_back(window);
+        }
+    }
+};
+
+QRect activeWindowRect()
+{
+    if (!KWindowSystem::isPlatformWayland()) {
+        return {};
+    }
+
+    const std::unique_ptr<wl_display, decltype(&wl_display_disconnect)> display(wl_display_connect(nullptr), wl_display_disconnect);
+    if (!display) {
+        return {};
+    }
+    const std::unique_ptr<wl_registry, decltype(&wl_registry_destroy)> registry(wl_display_get_registry(display.get()), wl_registry_destroy);
+    if (!registry) {
+        return {};
+    }
+    ActiveWindowQuery query;
+    constexpr wl_registry_listener listener{
+        [](void *data, wl_registry *registry, uint32_t name, const char *interface, uint32_t version) {
+            if (version >= 17 && qstrcmp(interface, "org_kde_plasma_window_management") == 0) {
+                static_cast<ActiveWindowQuery *>(data)->init(registry, name, 17);
+            }
+        },
+        [](void *, wl_registry *, uint32_t) {},
+    };
+    wl_registry_add_listener(registry.get(), &listener, &query);
+    // Announce the global, announce its windows, then receive their initial state.
+    if (wl_display_roundtrip(display.get()) < 0 || !query.isInitialized()
+        || wl_display_roundtrip(display.get()) < 0 || wl_display_roundtrip(display.get()) < 0) {
+        return {};
+    }
+    for (const auto &window : query.windows) {
+        if (window.active) {
+            return window.rect;
+        }
+    }
+    return {};
+}
+}
 
